{
  "name": "wexample/symfony-remote-db-ip",
  "description": "The country of an IP address, from DB-IP's free IP to Country Lite database, downloaded and read on the machine",
  "version": "2.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteDbIp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteDbIp\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "maxmind-db/reader": "^1.12",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/http-client": "^7.4 || ^8.0",
    "wexample/symfony-geo": ">=8.0.0",
    "wexample/symfony-helpers": ">=17.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}